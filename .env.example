# ContractAI - Environment Variables Template
# Copy this file to .env and fill in your values

# ===========================================
# Application Settings
# ===========================================
APP_NAME=ContractAI
APP_ENV=development
DEBUG=true
SECRET_KEY=your-super-secret-key-min-32-chars-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===========================================
# Database (PostgreSQL with pgvector)
# ===========================================
DATABASE_URL=postgresql+asyncpg://contractai:contractai@db:5432/contractai
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ===========================================
# Redis / Celery
# ===========================================
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_TRACK_STARTED=true
CELERY_TASK_TIME_LIMIT=480
CELERY_TASK_SOFT_TIME_LIMIT=450
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_WORKER_MAX_TASKS_PER_CHILD=100

# ===========================================
# LLM Providers (at least one required)
# ===========================================
# NVIDIA Nemotron (recommended for POC - free tier available)
NVIDIA_API_KEY=your-nvidia-api-key

# OpenAI (optional)
OPENAI_API_KEY=your-openai-api-key

DEFAULT_LLM_PROVIDER=nvidia
OPENAI_MODEL=gpt-4-turbo-preview
NVIDIA_MODEL=nemotron-3-ultra

# SECURITY: Disable fallback between providers in production
LLM_FALLBACK_ENABLED=false

# ===========================================
# Google Drive OAuth2
# ===========================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/connectors/google/callback
GOOGLE_SCOPES=https://www.googleapis.com/auth/drive.readonly

# ===========================================
# OneDrive / Microsoft Graph OAuth2
# ===========================================
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/v1/connectors/onedrive/callback
MICROSOFT_SCOPES=https://graph.microsoft.com/Files.Read

# ===========================================
# File Storage
# ===========================================
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,docx,txt
UPLOAD_DIR=/app/uploads

# ===========================================
# LGPD / Compliance
# ===========================================
DATA_RETENTION_DAYS=2555
AUDIT_LOG_RETENTION_DAYS=2555
ANONYMIZE_ON_DELETE=true

# ===========================================
# Monitoring
# ===========================================
PROMETHEUS_METRICS_ENABLED=true
LOG_LEVEL=INFO
LOG_FORMAT=json

# ===========================================
# CORS
# ===========================================
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ===========================================
# Frontend
# ===========================================
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000